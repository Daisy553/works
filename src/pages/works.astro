---
import Base from '../layouts/Base.astro';
import { siteTagline } from '../lib/site.mjs';
---

<Base title="作品" description={`Daisy Lab 的作品。${siteTagline}`} bodyClass="is-works">
  <main class="portfolio-shell" id="content" data-portfolio-shell>
    <header class="identity-panel" aria-label="作品">
      <p class="eyebrow">作品</p>
      <h1>Daisy Lab</h1>
      <p>{siteTagline}</p>
      <a class="contact-link" href="/">回到文章</a>
    </header>

    <section class="album-stage" aria-label="桌面作品档案">
      <div class="album-track" data-album-track aria-live="polite"></div>

      <div class="album-controls">
        <button type="button" class="album-control album-control-prev" data-album-prev aria-label="上一件作品">
          Previous
        </button>
        <button type="button" class="album-control album-control-next" data-album-next aria-label="下一件作品">
          Next
        </button>
      </div>
    </section>

    <nav class="directory" data-category-nav aria-label="作品分类"></nav>
  </main>

  <section class="detail-view" id="work-detail" aria-hidden="true" aria-labelledby="detail-title">
    <div class="detail-panel" role="dialog" aria-modal="true" aria-labelledby="detail-title">
      <button type="button" class="detail-close" data-detail-close aria-label="关闭作品详情">
        Close
      </button>

      <div class="detail-gallery">
        <div class="detail-media" id="detail-media-stage" data-detail-media></div>
      </div>

      <div class="detail-copy">
        <p class="detail-kicker" data-detail-kicker></p>
        <h2 id="detail-title" data-detail-title></h2>

        <section class="detail-copy-section" aria-labelledby="detail-overview-label">
          <p class="detail-section-label" id="detail-overview-label">项目概述</p>
          <p class="detail-summary" data-detail-summary></p>
        </section>

        <section class="detail-copy-section" aria-labelledby="detail-role-label">
          <p class="detail-section-label" id="detail-role-label">我的职责</p>
          <p class="detail-role" data-detail-role></p>
        </section>

        <ul class="detail-tags" data-detail-tags></ul>

        <section class="detail-copy-section" aria-labelledby="detail-process-label">
          <p class="detail-section-label" id="detail-process-label">设计要点</p>
          <ul class="detail-points" data-detail-points></ul>
        </section>
      </div>

      <section class="detail-evidence" data-detail-evidence hidden aria-labelledby="detail-evidence-title">
        <div class="detail-evidence-heading">
          <p class="detail-section-label">技术拆解</p>
          <h3 id="detail-evidence-title">从采样到残影复用</h3>
        </div>

        <div class="detail-breakdown" data-detail-breakdown></div>

        <section class="detail-code-section" data-detail-code-section aria-labelledby="detail-code-title">
          <div class="detail-code-heading">
            <p class="detail-section-label">关键实现</p>
            <h3 id="detail-code-title">采样、缓冲与对象池</h3>
          </div>
          <div class="detail-code-list" data-detail-code></div>
        </section>
      </section>
    </div>
  </section>
</Base>
