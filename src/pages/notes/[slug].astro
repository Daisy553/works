---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import {
  adjacentPosts,
  formatPostDate,
  postDateTime,
  publishedPosts,
  readingMinutesFor,
  tagSlug,
} from '../../lib/posts.mjs';
import { absoluteUrl, defaultImage } from '../../lib/site.mjs';

export async function getStaticPaths() {
  const posts = publishedPosts(await getCollection('posts'));

  return posts.map((post) => ({
    params: { slug: post.id },
  }));
}

const { slug } = Astro.params;
const posts = publishedPosts(await getCollection('posts'));
const post = posts.find((entry) => entry.id === slug);

if (!post) {
  throw new Error(`Missing note: ${slug}`);
}

const { Content } = await render(post);
const { newer, older } = adjacentPosts(posts, post.id);
const minutes = readingMinutesFor(post);
const published = postDateTime(post);
const image = post.data.image || defaultImage;
const site = Astro.site ?? new URL('https://daisy553.pages.dev');
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: post.data.title,
  description: post.data.description,
  datePublished: published,
  inLanguage: post.data.lang === 'en' ? 'en' : 'zh-CN',
  articleSection: post.data.category,
  keywords: post.data.tags.join(', '),
  image: new URL(image, site).href,
  mainEntityOfPage: absoluteUrl(`/notes/${post.id}/`, site),
  author: {
    '@type': 'Person',
    name: '智勇',
  },
  publisher: {
    '@type': 'Organization',
    name: 'Daisy Lab',
  },
};
---

<Base
  title={post.data.title}
  description={post.data.description}
  image={image}
  imageAlt={post.data.imageAlt}
  type="article"
  publishedTime={published}
  bodyClass="is-reading"
>
  <article class="article-shell" id="content" lang={post.data.lang === 'en' ? 'en' : 'zh-CN'}>
    <header class="article-header">
      <p class="article-kicker">{post.data.sample ? '样稿' : '文章'} · {post.data.category}</p>
      <h1>{post.data.title}</h1>
      <p class="post-meta">
        <time datetime={published}>{formatPostDate(post)}</time>
        <span>约 {minutes} 分钟</span>
      </p>
    </header>
    <div class="prose">
      <Content />
    </div>
    <ul class="article-tags">
      {
        post.data.tags.map((tag) => (
          <li>
            <a href={`/tags/${tagSlug(tag)}/`}>{tag}</a>
          </li>
        ))
      }
    </ul>
    <nav class="post-pager" aria-label="相邻文章">
      {
        older && (
          <a class="pager-prev" href={`/notes/${older.id}/`} rel="prev">
            <span>上一篇</span>
            <strong>{older.data.title}</strong>
          </a>
        )
      }
      {
        newer && (
          <a class="pager-next" href={`/notes/${newer.id}/`} rel="next">
            <span>下一篇</span>
            <strong>{newer.data.title}</strong>
          </a>
        )
      }
    </nav>
  </article>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
</Base>
