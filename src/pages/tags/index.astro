---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { collectTags, publishedPosts } from '../../lib/posts.mjs';

const tags = collectTags(publishedPosts(await getCollection('posts')));
const description = 'Daisy Lab 文章的标签。';
---

<Base title="标签" description={description} bodyClass="is-page">
  <main class="blog-column" id="content">
    <header class="page-head">
      <h1>标签</h1>
      <p class="page-intro">按标签回看文章。</p>
    </header>
    <ul class="tag-index">
      {
        tags.map((entry) => (
          <li>
            <a href={`/tags/${entry.slug}/`}>
              <strong>{entry.tag}</strong>
              <span class="tag-count">{entry.posts.length}</span>
            </a>
          </li>
        ))
      }
    </ul>
  </main>
</Base>
