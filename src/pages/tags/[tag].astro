---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import PostList from '../../components/PostList.astro';
import { collectTags, publishedPosts } from '../../lib/posts.mjs';

export async function getStaticPaths() {
  const tags = collectTags(publishedPosts(await getCollection('posts')));

  return tags.map((entry) => ({
    params: { tag: entry.slug },
  }));
}

const posts = publishedPosts(await getCollection('posts'));
const match = collectTags(posts).find((entry) => entry.slug === Astro.params.tag);

if (!match) {
  throw new Error(`Missing tag: ${Astro.params.tag}`);
}

const description = `标签「${match.tag}」下的文章。`;
---

<Base title={match.tag} description={description} bodyClass="is-page">
  <main class="blog-column" id="content">
    <header class="page-head">
      <h1>{match.tag}</h1>
      <p class="page-intro">{match.posts.length} 篇</p>
    </header>
    <PostList posts={match.posts} />
    <a class="more-link" href="/tags/">全部标签</a>
  </main>
</Base>
