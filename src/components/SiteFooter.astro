---
import { loadPortfolio } from '../lib/portfolio.mjs';

const { email, links } = loadPortfolio().owner;
---

<footer class="site-foot">
  <p>Daisy Lab</p>
  <ul aria-label="联系方式">
    <li>
      <a href={`mailto:${email}`} aria-label="邮箱">
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <rect x="3.5" y="5.5" width="17" height="13" rx="1.5"></rect>
          <path d="M4 7l8 6 8-6"></path>
        </svg>
      </a>
    </li>
    <li>
      <a href={links.bilibili} aria-label="Bilibili" target="_blank" rel="noopener noreferrer">
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <path d="M8 4l1.2 2.2M16 4L14.8 6.2"></path>
          <rect x="3.5" y="7" width="17" height="12" rx="1.5"></rect>
          <path d="M8 12.5v2M16 12.5v2"></path>
        </svg>
      </a>
    </li>
    <li>
      <a href={links.github} aria-label="GitHub" target="_blank" rel="noopener noreferrer">
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <path d="M9 19c-4 1.5-4-2.5-6-3m12 6v-3.9a3.4 3.4 0 0 0-.9-2.6c3-.4 6.1-1.5 6.1-6.6a5.2 5.2 0 0 0-1.4-3.6 4.8 4.8 0 0 0-.1-3.5s-1.1-.3-3.5 1.3a12 12 0 0 0-6.2 0C6.4 2.9 5.3 3.2 5.3 3.2a4.8 4.8 0 0 0-.1 3.5 5.2 5.2 0 0 0-1.4 3.6c0 5.1 3.1 6.2 6.1 6.6a3.4 3.4 0 0 0-.9 2.6V22"></path>
        </svg>
      </a>
    </li>
  </ul>
</footer>
