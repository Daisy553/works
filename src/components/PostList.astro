---
import { formatPostDate, postDateTime, readingMinutesFor } from '../lib/posts.mjs';

interface Props {
  posts: Array<{
    id: string;
    body?: string;
    data: {
      title: string;
      description: string;
      date: Date;
      dateLabel?: string;
      category: string;
      tags: string[];
      image?: string;
      imageAlt?: string;
    };
  }>;
}

const { posts } = Astro.props;
---

<ol class="feed">
  {
    posts.map((post) => (
      <li>
        <a class="feed-item" href={`/notes/${post.id}/`}>
          <span class="feed-thumb" aria-hidden="true">
            {post.data.image ? (
              <img src={post.data.image} alt="" />
            ) : (
              <span class="cover-fallback"></span>
            )}
          </span>
          <span class="feed-copy">
            <p class="post-meta">
              <time datetime={postDateTime(post)}>{formatPostDate(post)}</time>
              <span>{post.data.category}</span>
              <span>约 {readingMinutesFor(post)} 分钟</span>
            </p>
            <h2>{post.data.title}</h2>
            <p class="feed-dek">{post.data.description}</p>
            <p class="post-meta">
              {post.data.tags.map((tag) => (
                <span>{tag}</span>
              ))}
            </p>
          </span>
        </a>
      </li>
    ))
  }
</ol>
