---
const path = Astro.url.pathname;

const links = [
  { href: '/', label: '文章', current: path === '/' || path.startsWith('/notes/') },
  { href: '/archive/', label: '归档', current: path.startsWith('/archive/') },
  { href: '/tags/', label: '标签', current: path.startsWith('/tags/') },
  { href: '/about/', label: '关于', current: path.startsWith('/about/') },
  { href: '/rss.xml', label: 'RSS', current: false },
  { href: '/works/', label: '作品', current: path.startsWith('/works/') },
];
---

<nav class="room-nav" aria-label="站点">
  <a class="nav-mark" href="/">Daisy Lab</a>
  <ul class="nav-links">
    {
      links.map((link) => (
        <li>
          <a href={link.href} aria-current={link.current ? 'page' : undefined}>
            {link.label}
          </a>
        </li>
      ))
    }
  </ul>
</nav>
